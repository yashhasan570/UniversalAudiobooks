[Unit]
Description=Self-hosted audiobook server for managing and playing audiobooks
Requires=network.target

[Service]
Type=simple
EnvironmentFile=/etc/default/universalaudiobooks
WorkingDirectory=/usr/share/universalaudiobooks
ExecStart=/usr/share/universalaudiobooks/universalaudiobooks
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
User=universalaudiobooks
Group=universalaudiobooks
Environment=HOME=/var/cache/universalaudiobooks
CacheDirectory=universalaudiobooks

[Install]
WantedBy=multi-user.target